# Copy to .env and adjust. The API reads these from the environment
# (e.g. `node --env-file=.env apps/api/src/server.js`, or export them in your shell).

NODE_ENV=development
API_PORT=3001
# Cloud hosts (Render/Railway) provide PORT automatically; API binds to 0.0.0.0.
# SQLite file; leave empty for apps/api/data/wow-platform.db (MongoDB runtime migration is not included in this version)
WOW_DB_PATH=

# Sessions / login protection
SESSION_TTL_HOURS=168
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MIN=15

# Demo accounts (customer@wow.test, murugan@wow.test ... password Water@123).
# Default: on in development, off in production.
SEED_DEMO_USERS=true

# CORS: set to * for public app clients, or a comma-free allowed web origin.
CORS_ORIGIN=*

# Required in production for POST /v1/webhooks/whatsapp (x-webhook-secret header)
WHATSAPP_WEBHOOK_SECRET=

# Reserved hook for background push notifications (FCM / Web Push / Expo)
PUSH_PROVIDER=

# Web app (apps/web/.env): only if the API is on another origin
# VITE_API_BASE_URL=http://localhost:3001

# Required for real signup SMS OTP (Twilio Verify). Set these on the API server.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Required for real online UPI checkout via Razorpay Payment Links. Never commit real secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional public callback URL (e.g. https://your-domain.example/payment-result)
RAZORPAY_CALLBACK_URL=

# --- Mobile app (apps/mobile) -------------------------------------------------
# Shown on the customer Help & Support screen. The buttons only appear when set.
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=
